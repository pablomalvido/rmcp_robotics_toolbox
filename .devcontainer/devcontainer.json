{
    "name": "Ubuntu22 Robotics Toolbox",
    "build": {
        "dockerfile": "Dockerfile"
    },

    "workspaceFolder": "/workspace",

    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",

    // "mounts": [
    //     "source=/tmp/.X11-unix,target=/tmp/.X1-unix,type=bind"
    // ],

    // "runArgs": [
    //     "--network=host"
    // ],

    "forwardPorts": [
        8000,
        8080
    ],

    "portsAttributes": {
        "8000": {
            "label": "Swift"
        },
        "8080": {
            "label": "Swift"
        }
    },

    "containerEnv": {
        "DISPLAY": "host.docker.internal:0.0", //"${localEnv:DISPLAY}"
        "LIBGL_ALWAYS_INDIRECT": "1"
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance"
            ]
        }
    },

    "postCreateCommand": "cd /workspace/robotics-toolbox-python && pip install -e .",

    "remoteUser": "root"
}